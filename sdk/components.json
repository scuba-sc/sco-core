{
 "schema_version": 1,
 "about": "The SDK's files, their release profiles and their origin. sdk/package.py reads this and nothing else to decide what a zip holds; sc-offline's tools/sdk-headers.py reads public_header from it. Every file under the folders in 'covers' must be listed here or in 'excluded'.",
 "profiles": {
  "core": {
   "zip": "sco-sdk-core-{version}",
   "version_from": "sdk/VERSION",
   "about": "The game-neutral plugin SDK: the sco_api ABI, the host services, the C, C++, C# and Lua layers, examples and tools."
  },
  "game-sc": {
   "zip": "sco-sdk-game-sc-{game_pack_version}",
   "version_from": "include/sc_game_pack.h",
   "requires": "core",
   "about": "The optional Star Citizen extension: the game pack's service tables and events, DataCore, their C++ and C# wrappers, game examples and docs. Unpack over the core SDK of the version it names."
  },
  "legacy": {
   "zip": "sco-sdk-{version}",
   "version_from": "sdk/VERSION",
   "includes": [
    "core",
    "game-sc"
   ],
   "about": "Everything in one zip, as sdk-v1.1.0 shipped. Not game-neutral. Kept until consumers move to core + game-sc."
  }
 },
 "covers": [
  "include",
  "sdk"
 ],
 "excluded": [
  {
   "path": "include/sco/",
   "why": "the kernel's internal headers; not part of the plugin ABI"
  },
  {
   "path": "sdk/package.py",
   "why": "packaging tool"
  },
  {
   "path": "sdk/components.json",
   "why": "this manifest"
  },
  {
   "path": "sdk/test-zip.sh",
   "why": "packaging test"
  },
  {
   "path": "sdk/.gitignore",
   "why": "repository file"
  },
  {
   "path": "sdk/test_package.py",
   "why": "packaging test"
  }
 ],
