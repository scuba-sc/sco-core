{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sco:release-approval:1",
  "title": "SCO release approval v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "decision",
    "release_tag",
    "approved_at",
    "expires_at",
    "approver",
    "source",
    "build",
    "profiles",
    "artifacts",
    "distribution",
    "exceptions"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "decision": {
      "enum": [
        "approve",
        "hold"
      ]
    },
    "release_tag": {
      "type": "string",
      "pattern": "^sdk-v[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "approved_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "approver": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identity",
        "key_fingerprint"
      ],
      "properties": {
        "identity": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "key_fingerprint": {
          "type": "string",
          "minLength": 1,
          "pattern": "^SHA256:[A-Za-z0-9+/]{43}$"
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "commit",
        "components_sha256",
        "dependencies"
      ],
      "properties": {
        "repository": {
          "const": "scubamount/sco-core"
        },
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "components_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "dependencies": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "repository",
              "commit"
            ],
            "properties": {
              "repository": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "commit": {
                "type": "string",
                "pattern": "^[0-9a-f]{40}$"
              }
            }
          }
        }
      }
    },
    "build": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workflow_commit",
        "run_id",
        "run_attempt",
        "artifact_ids",
        "evidence_sha256"
      ],
      "properties": {
        "workflow_commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "run_id": {
          "type": "integer",
          "minimum": 1
        },
        "run_attempt": {
          "type": "integer",
          "minimum": 1
        },
        "artifact_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 1
          }
        },
        "evidence_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "profiles": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "core",
          "game-sc",
          "legacy"
        ]
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "role",
          "bytes",
          "sha256"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]*$",
            "maxLength": 180
          },
          "role": {
            "enum": [
              "sdk-core",
              "sdk-game-sc",
              "sdk-legacy",
              "source",
              "sbom",
              "checksums",
              "provenance",
              "notice",
              "compatibility",
              "release-notes"
            ]
          },
          "bytes": {
            "type": "integer",
            "minimum": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "distribution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "scope",
        "rights_record_digest",
        "source_plan_digest",
        "external_counsel"
      ],
      "properties": {
        "status": {
          "enum": [
            "internal-only",
            "approved-for-publication",
            "hold"
          ]
        },
        "scope": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        },
        "rights_record_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "source_plan_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "external_counsel": {
          "enum": [
            "not_obtained",
            "obtained"
          ]
        }
      }
    },
    "exceptions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "scope",
          "reason",
          "expires_at"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "scope": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "expires_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    }
  }
}
